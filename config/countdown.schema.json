{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Countdown Studio settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "durationSeconds",
    "autoStart",
    "showBackground",
    "textColor",
    "backgroundColor",
    "fontSizePercent",
    "timeFormat"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "durationSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 604800
    },
    "autoStart": {
      "type": "boolean"
    },
    "showBackground": {
      "type": "boolean"
    },
    "textColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{8}$",
      "description": "ARGB hexadecimal color, for example #FFFFFFFF."
    },
    "backgroundColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{8}$",
      "description": "ARGB hexadecimal color with alpha, for example #99000000."
    },
    "fontSizePercent": {
      "type": "integer",
      "minimum": 25,
      "maximum": 100
    },
    "timeFormat": {
      "type": "string",
      "enum": [
        "automatic",
        "MM:SS",
        "HH:MM:SS"
      ]
    }
  }
}
