{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Countdown Studio settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "durationSeconds",
    "autoStart",
    "showBackground"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "durationSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 604800
    },
    "autoStart": {
      "type": "boolean"
    },
    "showBackground": {
      "type": "boolean"
    }
  }
}
