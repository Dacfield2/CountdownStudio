{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Countdown Studio settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "durationSeconds",
    "autoStart",
    "showBackground",
    "textColor",
    "backgroundColor",
    "font",
    "fontSizePercent",
    "timeFormat"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "durationSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 604800
    },
    "autoStart": {
      "type": "boolean"
    },
    "showBackground": {
      "type": "boolean"
    },
    "textColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{8}$",
      "description": "ARGB hexadecimal color, for example #FFFFFFFF."
    },
    "backgroundColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{8}$",
      "description": "ARGB hexadecimal color with alpha, for example #99000000."
    },
    "font": {
      "type": "object",
      "additionalProperties": false,
      "required": ["face", "style", "size", "flags"],
      "properties": {
        "face": { "type": "string", "minLength": 1 },
        "style": { "type": "string" },
        "size": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "flags": { "type": "integer", "minimum": 0, "maximum": 15 }
      }
    },
    "customFontFile": {
      "type": "string",
      "description": "Optional path to a TTF, OTF, or TTC font file. The file is loaded locally and is not bundled with a scene or plugin package."
    },
    "fontSizePercent": {
      "type": "integer",
      "minimum": 25,
      "maximum": 100
    },
    "timeFormat": {
      "type": "string",
      "enum": [
        "automatic",
        "MM:SS",
        "HH:MM:SS"
      ]
    },
    "endMessage": {
      "type": "string",
      "description": "Optional text rendered when the countdown reaches zero."
    }
  }
}
